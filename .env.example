# Never place real secrets in this file.

# Explicit runtime selection. Demo needs no database or hosted provider.
APP_MODE=demo

# Server configuration: browser origins allowed to call the API. This is not sent to the frontend bundle.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Browser-visible build configuration: public backend URL compiled during `docker compose build`.
# Never place a provider key, database URL, password, or other secret in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostgreSQL with the pgvector extension. Used by document ingestion and retrieval.
DATABASE_URL=postgresql://agentic_intelligence:replace-me@localhost:5432/agentic_intelligence
DATABASE_CONNECT_TIMEOUT_SECONDS=3
POSTGRES_DB=agentic_intelligence
POSTGRES_USER=agentic_intelligence
POSTGRES_PASSWORD=replace-me

# Production artifact bodies stay on local disk; PostgreSQL stores metadata and hashes.
ARTIFACT_STORAGE_PATH=./var/artifacts

# Hosted embedding provider. Tests and controlled evaluation do not use this key.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=replace-me
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100

# Production task execution configuration. Demo uses bounded deterministic providers.
ORCHESTRATOR_PROVIDER=openai
ORCHESTRATOR_API_KEY=replace-me
ORCHESTRATOR_BASE_URL=https://api.openai.com/v1
ORCHESTRATOR_MODEL=gpt-6-astra
ORCHESTRATOR_TIMEOUT_SECONDS=30
ORCHESTRATOR_MAX_RETRIES=2
ORCHESTRATOR_MAX_OUTPUT_TOKENS=3000
# Optional current rates supplied by the operator; configure both or neither.
# ORCHESTRATOR_INPUT_COST_PER_MILLION=1.25
# ORCHESTRATOR_OUTPUT_COST_PER_MILLION=10.00

# Deterministic PDF processing limits.
PDF_MAX_UPLOAD_BYTES=20971520
RETRIEVAL_CHUNK_SIZE=1200
RETRIEVAL_CHUNK_OVERLAP=200

# Phase 2 external sources. Passwords and tokens stay in the environment, never in recipes.
# ALLOW_PRIVATE_REST_TARGETS=1
# EXTERNAL_PG_PASSWORD=replace-me
# REST_BEARER_TOKEN=replace-me
