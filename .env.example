# Never place real secrets in this file.

# PostgreSQL with the pgvector extension. Used by document ingestion and retrieval.
DATABASE_URL=postgresql://agentic_intelligence:replace-me@localhost:5432/agentic_intelligence
POSTGRES_DB=agentic_intelligence
POSTGRES_USER=agentic_intelligence
POSTGRES_PASSWORD=replace-me

# Hosted embedding provider. Tests and controlled evaluation do not use this key.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=replace-me
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100

# Deterministic PDF processing limits.
PDF_MAX_UPLOAD_BYTES=20971520
RETRIEVAL_CHUNK_SIZE=1200
RETRIEVAL_CHUNK_OVERLAP=200
