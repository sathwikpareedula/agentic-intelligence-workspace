{
  "version": 1,
  "cases": [
    {
      "id": "goal_to_typed_plan",
      "capability": "natural-language goal to a correct typed deterministic plan",
      "goal": "Using the bound sales data, report total net sales by region. Inspect before calculating.",
      "tools": ["resource.list", "dataset.inspect", "analytics.execute"],
      "steps": [
        {
          "tool": "resource.list",
          "observation": {
            "success": true,
            "summary": "Listed one bound dataset.",
            "result": {"datasets": ["sales.csv"], "document_ids": [], "workflow_ids": []}
          }
        },
        {
          "tool": "dataset.inspect",
          "required_arguments": {"dataset": "sales.csv"},
          "observation": {
            "success": true,
            "summary": "Inspected sales.csv.",
            "result": {"filename": "sales.csv", "columns": ["region", "net_sales"], "row_count": 4}
          }
        },
        {
          "tool": "analytics.execute",
          "required_arguments": {
            "dataset": "sales.csv",
            "plan": {
              "analysis": "metrics",
              "group_by": ["region"],
              "metrics": [{"name": "sum", "column": "net_sales", "alias": "net_sales"}]
            }
          },
          "observation": {
            "success": true,
            "summary": "Calculated regional net sales deterministically.",
            "result": {
              "facts": [{"key": "regional.North.net_sales", "value": 1200.0, "unit": "USD"}],
              "verification_facts": {"regional.North.net_sales": 1200.0}
            }
          }
        }
      ],
      "fixture_decisions": [
        {"type": "tool_call", "tool": "resource.list", "arguments": {}},
        {"type": "tool_call", "tool": "dataset.inspect", "arguments": {"dataset": "sales.csv"}},
        {
          "type": "tool_call",
          "tool": "analytics.execute",
          "arguments": {
            "dataset": "sales.csv",
            "plan": {
              "analysis": "metrics",
              "group_by": ["region"],
              "metrics": [{"name": "sum", "column": "net_sales", "alias": "net_sales"}],
              "expected_columns": ["region", "net_sales"]
            }
          }
        },
        {
          "type": "complete",
          "answer": "North net sales are 1200 USD.",
          "claims": [{"text": "North net sales are 1200 USD.", "kind": "numeric", "value": 1200.0, "evidence_keys": ["regional.North.net_sales"], "unit": "USD"}]
        }
      ],
      "expectation": {
        "tool_sequence": ["resource.list", "dataset.inspect", "analytics.execute"],
        "resource_argument_paths": {"dataset.inspect": ["dataset"], "analytics.execute": ["dataset"]},
        "allowed_resource_ids": ["sales.csv"],
        "allowed_evidence_keys": ["regional.North.net_sales"],
        "allowed_numbers": ["1200"],
        "required_answer_terms": ["North", "1200", "USD"],
        "max_tool_calls": 3
      }
    },
